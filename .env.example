# Локально: скопируйте в .env. Пароли и .env не коммитить.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUSTED_PROXY_IPS=127.0.0.1
INTERLINKER_DB=local-data/interlinker.sqlite3
# Локальный SMTP-inbox Mailpit поднимается Docker Compose автоматически.
# Откройте http://127.0.0.1:8025, чтобы увидеть письмо регистрации.
# Для внешней почты задайте SMTP_HOST/PORT/USER/PASSWORD/FROM.
# Beget: SMTP_HOST=smtp.beget.com, SMTP_PORT=465, SMTP_SSL=true.
# Внешний SMTP без TLS/SSL блокируется приложением.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=false
SMTP_SSL=false
WP_SITE_URL=https://dagorod.ru
WP_DB_HOST=
WP_DB_PORT=3306
WP_DB_NAME=
WP_DB_USER=
WP_DB_PASSWORD=
WP_DB_PREFIX=wp_
# Для прямого TLS-соединения путь к CA. Для SSH-туннеля: host=127.0.0.1.
WP_DB_SSL_CA=
